#!/bin/bash
# SSH-PLUS BY El NeNe Pro - Renovar / cambiar vencimiento
tput setaf 7; tput setab 4; tput bold; printf '%33s%s%-12s\n' "RENOVAR FECHA DE USUARIO"; tput sgr0
DB="/root/usuarios.db"
list_users() { awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd | sort; }
expiry_raw() { chage -l "$1" 2>/dev/null | awk -F': ' '/Account expires|La cuenta caduca|Cuenta caduca|Conta expira/{print $2; exit}'; }
show_date() {
    local user="$1" exp databr hoy normal dias
    exp="$(expiry_raw "$user")"
    if [[ -z "$exp" || "$exp" == "never" || "$exp" == "nunca" ]]; then
        echo -e "\033[1;33mSin vencimiento\033[0m"; return
    fi
    databr=$(date -d "$exp" +%Y%m%d 2>/dev/null) || { echo -e "\033[1;31mFecha desconocida\033[0m"; return; }
    hoy=$(date -d today +%Y%m%d)
    normal=$(date -d "$exp" +%d/%m/%Y)
    if [[ $hoy -ge $databr ]]; then echo -e "\033[1;31m$normal VENCIDO\033[0m"; else echo -e "\033[1;32m$normal VIGENTE\033[0m"; fi
}

echo -e "\n\033[1;33mLISTA DE USUARIOS Y VENCIMIENTO:\033[0m\n"
i=0; unset MAP_USER
while read -r user; do
    [[ -z "$user" ]] && continue
    i=$((i+1)); MAP_USER[$i]="$user"
    printf '\033[1;31m[\033[1;36m%02d\033[1;31m] \033[1;37m- \033[1;32m%-18s\033[0m ' "$i" "$user"
    show_date "$user"
done <<< "$(list_users)"
[[ $i -eq 0 ]] && { echo -e "\033[1;31mNo hay usuarios para renovar.\033[0m"; exit 1; }

echo -ne "\n\033[1;32mEscribí número o nombre de usuario:\033[1;37m "; read -r option
if [[ "$option" =~ ^[0-9]+$ ]]; then usuario="${MAP_USER[$((10#$option))]}"; else usuario="$option"; fi
if [[ -z "$usuario" ]] || ! getent passwd "$usuario" >/dev/null; then echo -e "\n\033[1;31mUsuario inválido.\033[0m"; exit 1; fi

echo -e "\n\033[1;31mEjemplos:\033[1;33m 30 \033[1;37m(días)\033[1;33m o 21/12/2026 \033[1;37m(fecha exacta)\033[0m"
echo -ne "\033[1;32mNueva fecha o cantidad de días para \033[1;33m$usuario\033[1;37m: "; read -r inputdate
if [[ "$inputdate" =~ ^[0-9]+$ ]]; then
    udata=$(date "+%d/%m/%Y" -d "+$inputdate days")
    sysdate=$(date "+%Y-%m-%d" -d "+$inputdate days")
elif [[ "$inputdate" =~ ^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}$ ]]; then
    sysdate="$(echo "$inputdate" | awk -F/ '{printf "%04d-%02d-%02d", $3,$2,$1}')"
    date -d "$sysdate" >/dev/null 2>&1 || { echo -e "\033[1;31mFecha inválida.\033[0m"; exit 1; }
    udata=$(date "+%d/%m/%Y" -d "$sysdate")
else
    echo -e "\033[1;31mFormato inválido. Usá cantidad de días o DD/MM/AAAA.\033[0m"; exit 1
fi

today=$(date -d today +%Y%m%d)
target=$(date -d "$sysdate" +%Y%m%d)
if [[ $today -ge $target ]]; then echo -e "\033[1;31mLa fecha debe ser futura.\033[0m"; exit 1; fi

chage -E "$sysdate" "$usuario" || { echo -e "\033[1;31mNo se pudo cambiar la fecha.\033[0m"; exit 1; }
command -v uexpired >/dev/null 2>&1 && uexpired >/dev/null 2>&1 || true
echo -e "\n\E[44;1;37m Usuario $usuario renovado hasta $udata \E[0m"
