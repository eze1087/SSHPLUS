#!/bin/bash
# SSH-PLUS BY El NeNe Pro - Eliminar vencidos
DB="/root/usuarios.db"
PASSDIR="/etc/SSHPlus/senha"
datenow=$(date +%s)
touch "$DB" 2>/dev/null
remove_ovp() {
    local user="$1" groupname="nogroup"
    [[ ! -d /etc/openvpn/easy-rsa ]] && return 0
    cd /etc/openvpn/easy-rsa/ || return 0
    ./easyrsa --batch revoke "$user" >/dev/null 2>&1
    ./easyrsa gen-crl >/dev/null 2>&1
    rm -f "pki/reqs/$user.req" "pki/private/$user.key" "pki/issued/$user.crt" /etc/openvpn/crl.pem
    cp /etc/openvpn/easy-rsa/pki/crl.pem /etc/openvpn/crl.pem 2>/dev/null
    chown nobody:$groupname /etc/openvpn/crl.pem 2>/dev/null
    rm -f "/root/$user.ovpn" "/var/www/html/openvpn/$user.zip"
}
expiry_raw() { chage -l "$1" 2>/dev/null | awk -F': ' '/Account expires|La cuenta caduca|Cuenta caduca|Conta expira/{print $2; exit}'; }

echo -e "\E[44;1;37m Usuario          Fecha        Estado        Acción \E[0m\n"
removed=0
while read -r user; do
    expdate="$(expiry_raw "$user")"
    [[ -z "$expdate" || "$expdate" == "never" || "$expdate" == "nunca" ]] && continue
    expsec=$(date +%s --date="$expdate" 2>/dev/null) || continue
    datanormal=$(date -d "$expdate" '+%d/%m/%Y')
    printf '\033[1;33m%-16s\033[1;37m%-13s' "$user" "$datanormal"
    if [[ $datenow -le $expsec ]]; then
        echo -e "\033[1;32mVIGENTE      NO REMOVIDO\033[0m"
        continue
    fi
    echo -e "\033[1;31mVENCIDO      REMOVIDO\033[0m"
    pkill -u "$user" >/dev/null 2>&1 || true
    userdel -f "$user" >/dev/null 2>&1 || true
    grep -v -E "^${user}[[:space:]]" "$DB" > /tmp/usuarios.db.$$ 2>/dev/null || true
    mv /tmp/usuarios.db.$$ "$DB" 2>/dev/null || true
    rm -f "$PASSDIR/$user"
    [[ -e /etc/openvpn/server.conf ]] && remove_ovp "$user"
    removed=$((removed+1))
done <<< "$(awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd | sort)"
command -v uexpired >/dev/null 2>&1 && uexpired >/dev/null 2>&1 || echo '0' > /etc/SSHPlus/Exp 2>/dev/null
echo -e "\n\033[1;32mLimpieza terminada. Usuarios removidos: $removed\033[0m"
