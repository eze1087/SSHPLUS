#!/bin/bash
# SSH-PLUS BY El NeNe Pro - Eliminar usuarios
DB="/root/usuarios.db"
PASSDIR="/etc/SSHPlus/senha"
TESTDIR="/etc/SSHPlus/userteste"
touch "$DB" 2>/dev/null

remove_ovp() {
    local user="$1" groupname="nogroup"
    [[ ! -d /etc/openvpn/easy-rsa ]] && return 0
    cd /etc/openvpn/easy-rsa/ || return 0
    ./easyrsa --batch revoke "$user" >/dev/null 2>&1
    ./easyrsa gen-crl >/dev/null 2>&1
    rm -f "pki/reqs/$user.req" "pki/private/$user.key" "pki/issued/$user.crt" /etc/openvpn/crl.pem
    cp /etc/openvpn/easy-rsa/pki/crl.pem /etc/openvpn/crl.pem 2>/dev/null
    chown nobody:$groupname /etc/openvpn/crl.pem 2>/dev/null
    rm -f "/root/$user.ovpn" "/var/www/html/openvpn/$user.zip"
}

list_users() { awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd | sort; }
select_user() {
    local users user i option selected
    users="$(list_users)"
    [[ -z "$users" ]] && { echo -e "\033[1;31mNo hay usuarios SSH para mostrar.\033[0m" >&2; return 1; }
    i=0; unset MAP_USER
    while read -r user; do
        [[ -z "$user" ]] && continue
        i=$((i+1)); MAP_USER[$i]="$user"
        printf '\033[1;31m[\033[1;36m%02d\033[1;31m] \033[1;37m- \033[1;32m%s\033[0m\n' "$i" "$user" >&2
    done <<< "$users"
    echo "" >&2
    echo -ne "\033[1;32mEscribí número o nombre de usuario:\033[1;37m " >&2; read -r option
    if [[ "$option" =~ ^[0-9]+$ ]]; then selected="${MAP_USER[$((10#$option))]}"; else selected="$option"; fi
    [[ -z "$selected" ]] && return 1
    getent passwd "$selected" >/dev/null || return 1
    printf '%s' "$selected"
}

remove_user() {
    local user="$1"
    pkill -u "$user" >/dev/null 2>&1 || true
    pkill -f "$user" >/dev/null 2>&1 || true
    userdel -f "$user" >/dev/null 2>&1 || deluser --force "$user" >/dev/null 2>&1 || true
    grep -v -E "^${user}[[:space:]]" "$DB" > /tmp/usuarios.db.$$ 2>/dev/null || true
    mv /tmp/usuarios.db.$$ "$DB" 2>/dev/null || true
    rm -f "$PASSDIR/$user" "$TESTDIR/$user.sh"
    [[ -e /etc/openvpn/server.conf ]] && remove_ovp "$user"
}

clear
tput setaf 7; tput setab 4; tput bold; printf '%32s%s%-13s\n' "ELIMINAR USUARIO SSH"; tput sgr0
echo ""
echo -e "\033[1;31m[\033[1;36m1\033[1;31m]\033[1;33m ELIMINAR UN USUARIO"
echo -e "\033[1;31m[\033[1;36m2\033[1;31m]\033[1;33m ELIMINAR TODOS LOS USUARIOS"
echo -e "\033[1;31m[\033[1;36m0\033[1;31m]\033[1;33m VOLVER\033[0m\n"
read -p "$(echo -e "\033[1;32m¿Qué querés hacer? \033[1;37m")" -e -i 1 resp
case "$resp" in
    1)
        clear; tput setaf 7; tput setab 4; tput bold; printf '%32s%s%-13s\n' "ELIMINAR USUARIO SSH"; tput sgr0; echo ""
        user="$(select_user)" || { echo -e "\n\033[1;31mUsuario vacío o inválido.\033[0m"; exit 1; }
        echo -ne "\n\033[1;33mConfirmás eliminar a \033[1;37m$user\033[1;33m? [s/n]: \033[0m"; read -r ok
        [[ ! "$ok" =~ ^[sS]$ ]] && { echo -e "\033[1;31mCancelado.\033[0m"; exit 0; }
        remove_user "$user"
        echo -e "\n\E[41;1;37m Usuario $user eliminado correctamente. \E[0m"
        ;;
    2)
        echo -ne "\033[1;33m¿Seguro que querés eliminar TODOS los usuarios SSH? Escribí SI: \033[0m"; read -r opc
        [[ "$opc" != "SI" ]] && { echo -e "\033[1;31mCancelado.\033[0m"; exit 0; }
        while read -r user; do [[ -n "$user" ]] && remove_user "$user"; done <<< "$(list_users)"
        : > "$DB"
        rm -f /root/*.zip >/dev/null 2>&1
        echo -e "\n\033[1;32mUsuarios eliminados correctamente.\033[0m"
        ;;
    0) command -v menu >/dev/null 2>&1 && menu || exit 0 ;;
    *) echo -e "\n\033[1;31mOpción inválida.\033[0m"; exit 1 ;;
esac
