#!/usr/bin/env bash
# Redireccionamiento Python para SSHPLUS BY El NeNe
set -u
APP_NAME="SSHPLUS BY El NeNe - Redireccionamiento Python"
DEST="/etc/SSHPlus"
AUTOSTART="/etc/autostart"
BAD_BIN="/bin/badvpn-udpgw"
BAD_ENV="/etc/default/sshplus-badvpn"
BAD_SVC="badvpn-udpgw.service"
BAD_DEFAULT_PORT="7300"

RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; CYAN='\033[1;36m'; NC='\033[0m'

ok(){ echo -e "${GREEN}✅ $*${NC}"; }
warn(){ echo -e "${YELLOW}⚠️  $*${NC}"; }
err(){ echo -e "${RED}❌ $*${NC}"; }
pause(){ echo; read -r -p "Presioná ENTER para volver..." _; }
has_cmd(){ command -v "$1" >/dev/null 2>&1; }
need_root(){ [[ "${EUID:-$(id -u)}" -eq 0 ]] || { err "Ejecutalo como root."; exit 1; }; }
pybin(){ command -v python3 || command -v python || true; }

ensure_base(){
  mkdir -p "$DEST"
  touch "$AUTOSTART"
  chmod +x "$AUTOSTART" 2>/dev/null || true
  if ! has_cmd screen; then
    warn "Falta screen. Intento instalarlo con apt."
    apt-get update -y >/dev/null 2>&1 || true
    apt-get install -y screen >/dev/null 2>&1 || true
  fi
}

valid_port(){ [[ "$1" =~ ^[0-9]+$ ]] && (( "$1" >= 1 && "$1" <= 65535 )); }

port_busy(){
  local port="$1"
  if has_cmd ss; then ss -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)${port}$"; return $?; fi
  if has_cmd netstat; then netstat -lnt 2>/dev/null | awk '{print $4}' | grep -Eq "(^|:)${port}$"; return $?; fi
  return 1
}

show_listen(){
  if has_cmd ss; then ss -lntp 2>/dev/null | grep -E 'python|badvpn|dropbear|sshd' || true; return; fi
  if has_cmd netstat; then netstat -lntp 2>/dev/null | grep -E 'python|badvpn|dropbear|sshd' || true; return; fi
  warn "No encuentro ss/netstat para mostrar puertos."
}

stop_screen(){
  local name="$1"
  screen -ls 2>/dev/null | awk -v n=".${name}" '$0 ~ n {print $1}' | while read -r sid; do
    [[ -n "$sid" ]] && screen -S "$sid" -X quit >/dev/null 2>&1 || true
  done
  screen -wipe >/dev/null 2>&1 || true
}

clean_autostart_name(){
  local pattern="$1"
  [[ -f "$AUTOSTART" ]] && sed -i "\#${pattern}#d" "$AUTOSTART" 2>/dev/null || true
}

start_py(){
  local name="$1" file="$2" port="$3"
  local py; py="$(pybin)"
  [[ -n "$py" ]] || { err "No encuentro python3/python."; return 1; }
  [[ -f "$file" ]] || { err "No existe $file. Reinstalá el script para copiar los módulos."; return 1; }
  valid_port "$port" || { err "Puerto inválido: $port"; return 1; }
  if port_busy "$port"; then warn "El puerto $port ya aparece ocupado. Igual intento iniciar si es del mismo servicio."; fi
  stop_screen "$name"
  clean_autostart_name "$file"
  screen -dmS "$name" "$py" "$file" "$port"
  sleep 1
  if screen -ls 2>/dev/null | grep -q "\.${name}"; then
    echo "screen -dmS $name $py $file $port" >> "$AUTOSTART"
    ok "$name iniciado en puerto $port"
  else
    err "No pude iniciar $name. Revisá: $py $file $port"
    return 1
  fi
}

stop_all_py(){
  stop_screen proxy
  stop_screen ws
  stop_screen openpy
  stop_screen PDirect
  clean_autostart_name "proxy.py"
  clean_autostart_name "wsproxy.py"
  clean_autostart_name "open.py"
  clean_autostart_name "PDirect.py"
  ok "Redireccionamientos Python detenidos."
}

write_badvpn_env(){
  local port="${1:-$BAD_DEFAULT_PORT}"
  mkdir -p /etc/default
  echo "BADVPN_PORT=$port" > "$BAD_ENV"
  chmod 644 "$BAD_ENV"
}

badvpn_port(){
  if [[ -f "$BAD_ENV" ]]; then
    grep -E '^BADVPN_PORT=' "$BAD_ENV" | cut -d= -f2 | tr -d '[:space:]' | head -n1
  else
    echo "$BAD_DEFAULT_PORT"
  fi
}

write_badvpn_service(){
  local port; port="$(badvpn_port)"; [[ -n "$port" ]] || port="$BAD_DEFAULT_PORT"
  cat > "/etc/systemd/system/$BAD_SVC" <<EOF
[Unit]
Description=BadVPN UDPGW para SSHPLUS BY El NeNe
After=network.target

[Service]
EnvironmentFile=-$BAD_ENV
ExecStart=$BAD_BIN --listen-addr 127.0.0.1:\${BADVPN_PORT:-$port} --max-clients 10000 --max-connections-for-client 8 --client-socket-sndbuf 10000 --udp-mtu 9000
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload >/dev/null 2>&1 || true
}

ensure_badvpn_bin(){
  if [[ -x "$BAD_BIN" ]]; then return 0; fi
  if [[ -f "$DEST/badvpn-udpgw" ]]; then cp -f "$DEST/badvpn-udpgw" "$BAD_BIN"; chmod 755 "$BAD_BIN"; return 0; fi
  if [[ -f "/bin/badvpn-udpgw" ]]; then chmod 755 "$BAD_BIN"; return 0; fi
  err "No encuentro $BAD_BIN. Subí/instalá badvpn-udpgw en /bin o en $DEST."
  return 1
}

badvpn_enable(){
  local port="${1:-$(badvpn_port)}"; [[ -n "$port" ]] || port="$BAD_DEFAULT_PORT"
  valid_port "$port" || { err "Puerto BadVPN inválido: $port"; return 1; }
  ensure_badvpn_bin || return 1
  write_badvpn_env "$port"
  write_badvpn_service
  systemctl enable "$BAD_SVC" >/dev/null 2>&1 || true
  systemctl restart "$BAD_SVC" >/dev/null 2>&1 || true
  if systemctl is-active --quiet "$BAD_SVC"; then ok "BadVPN activo en 127.0.0.1:$port"; else warn "BadVPN no quedó activo. Mirá logs desde el menú."; fi
}

badvpn_disable(){
  systemctl stop "$BAD_SVC" >/dev/null 2>&1 || true
  systemctl disable "$BAD_SVC" >/dev/null 2>&1 || true
  pkill -f 'badvpn-udpgw' >/dev/null 2>&1 || true
  ok "BadVPN detenido/deshabilitado."
}

status(){
  echo -e "${CYAN}Procesos screen:${NC}"
  screen -ls 2>/dev/null || true
  echo
  echo -e "${CYAN}Puertos escuchando:${NC}"
  show_listen
  echo
  if has_cmd systemctl; then
    echo -e "${CYAN}BadVPN systemd:${NC} $(systemctl is-active "$BAD_SVC" 2>/dev/null || echo inactive) / $(systemctl is-enabled "$BAD_SVC" 2>/dev/null || echo disabled) | puerto ENV: $(badvpn_port)"
  fi
}

menu(){
  need_root
  ensure_base
  while true; do
    clear
    echo -e "${CYAN}╔══════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║  $APP_NAME${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════╝${NC}"
    status
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "[1] Activar PROXY SSH        (/etc/SSHPlus/proxy.py)"
    echo "[2] Activar WEBSOCKET SSH    (/etc/SSHPlus/wsproxy.py)"
    echo "[3] Activar OPENVPN redirect (/etc/SSHPlus/open.py)"
    echo "[4] Activar PDirect          (/etc/SSHPlus/PDirect.py)"
    echo "[5] Detener redireccionamientos Python"
    echo "[6] Reiniciar SSH/Dropbear"
    echo "[7] Activar/Habilitar BadVPN UDPGW"
    echo "[8] Detener/Deshabilitar BadVPN UDPGW"
    echo "[9] Ver logs BadVPN"
    echo "[0] Volver"
    echo
    read -r -p "Elegí opción: " op
    case "$op" in
      1) read -r -p "Puerto para PROXY SSH [80]: " p; p="${p:-80}"; start_py proxy "$DEST/proxy.py" "$p"; pause ;;
      2) read -r -p "Puerto para WEBSOCKET SSH [80]: " p; p="${p:-80}"; start_py ws "$DEST/wsproxy.py" "$p"; pause ;;
      3) read -r -p "Puerto para OPENVPN redirect [8080]: " p; p="${p:-8080}"; start_py openpy "$DEST/open.py" "$p"; pause ;;
      4) read -r -p "Puerto para PDirect [80]: " p; p="${p:-80}"; start_py PDirect "$DEST/PDirect.py" "$p"; pause ;;
      5) stop_all_py; pause ;;
      6) service dropbear stop 2>/dev/null || true; service ssh restart 2>/dev/null || service sshd restart 2>/dev/null || true; service dropbear start 2>/dev/null || true; ok "SSH/Dropbear reiniciado."; pause ;;
      7) read -r -p "Puerto BadVPN [7300]: " p; p="${p:-7300}"; badvpn_enable "$p"; pause ;;
      8) badvpn_disable; pause ;;
      9) journalctl -u "$BAD_SVC" --no-pager -n 80 2>/dev/null || warn "No hay logs de systemd para BadVPN."; pause ;;
      0) clear; return 0 ;;
      *) warn "Opción inválida."; sleep 1 ;;
    esac
  done
}

menu
