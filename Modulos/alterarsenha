#!/bin/bash
# SSH-PLUS BY El NeNe Pro - Cambiar contraseña de usuario
PASSDIR="/etc/SSHPlus/senha"
mkdir -p "$PASSDIR" 2>/dev/null
list_users() { awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd | sort; }

tput setaf 7; tput setab 4; tput bold; printf '%35s%s%-10s\n' "CAMBIAR CONTRASEÑA"; tput sgr0
echo -e "\n\033[1;33mLISTA DE USUARIOS:\033[0m\n"
i=0; unset MAP_USER
while read -r user; do
    [[ -z "$user" ]] && continue
    i=$((i+1)); MAP_USER[$i]="$user"
    senha="Sin guardar"; [[ -e "$PASSDIR/$user" ]] && senha="$(cat "$PASSDIR/$user")"
    printf '\033[1;31m[\033[1;36m%02d\033[1;31m] \033[1;37m- \033[1;32m%-18s\033[1;33m Contraseña actual: \033[1;37m%s\033[0m\n' "$i" "$user" "$senha"
done <<< "$(list_users)"
[[ $i -eq 0 ]] && { echo -e "\033[1;31mNo hay usuarios.\033[0m"; exit 1; }

echo -ne "\n\033[1;32mEscribí número o nombre de usuario:\033[1;37m "; read -r option
if [[ "$option" =~ ^[0-9]+$ ]]; then user="${MAP_USER[$((10#$option))]}"; else user="$option"; fi
[[ -z "$user" ]] || ! getent passwd "$user" >/dev/null && { echo -e "\033[1;31mUsuario inválido.\033[0m"; exit 1; }

echo -ne "\n\033[1;32mNueva contraseña para \033[1;33m$user\033[1;37m: "; read -r password
if [[ ${#password} -lt 4 ]]; then echo -e "\033[1;31mContraseña inválida. Mínimo 4 caracteres.\033[0m"; exit 1; fi

if pgrep -u "$user" >/dev/null 2>&1; then
    echo -e "\033[1;33mUsuario conectado. Desconectando sesiones para aplicar cambio...\033[0m"
    pkill -u "$user" >/dev/null 2>&1 || true
fi
echo "$user:$password" | chpasswd || { echo -e "\033[1;31mNo se pudo cambiar la contraseña.\033[0m"; exit 1; }
printf '%s\n' "$password" > "$PASSDIR/$user"
echo -e "\n\E[44;1;37m Contraseña cambiada: $user = $password \E[0m"
