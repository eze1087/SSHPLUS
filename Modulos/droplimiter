#!/bin/bash
# SSH-PLUS BY El NeNe Pro - Limitador Dropbear aproximado
DB="/root/usuarios.db"
[[ ! -f "$DB" ]] && { echo "Archivo $DB no encontrado"; exit 1; }

drop_sessions() {
    local user="$1" log="/var/log/auth.log"
    [[ ! -f "$log" ]] && { echo ""; return; }
    ps ax -o pid=,comm= | awk '$2 ~ /dropbear/ {print $1}' | while read -r pid; do
        grep "$pid" "$log" 2>/dev/null | grep 'Password auth succeeded' | tail -1 | grep -q "$user" && echo "$pid"
    done
}

while true; do
    clear
    echo -e "\E[42;1;37m               LIMITADOR DROPBEAR              \E[0m"
    echo -e "\E[42;1;37m Usuario                         Conexión/Límite \E[0m"
    while read -r user limit _; do
        [[ -z "$user" ]] && continue
        [[ -z "$limit" || ! "$limit" =~ ^[0-9]+$ ]] && limit=1
        mapfile -t pids < <(drop_sessions "$user")
        count=${#pids[@]}
        printf '  \033[1;33m%-32s\033[1;37m%s/%s\033[0m\n' "$user" "$count" "$limit"
        if [[ "$count" -gt "$limit" ]]; then
            echo -e "\E[41;1;37m Usuario desconectado por superar el límite. \E[0m"
            for ((i=limit; i<count; i++)); do kill "${pids[$i]}" >/dev/null 2>&1 || true; done
        fi
    done < "$DB"
    sleep 6
done
