#!/usr/bin/env bash
# Gestor BadVPN UDPGW corregido para SSHPLUS BY El NeNe
set -u
BAD_BIN="/bin/badvpn-udpgw"
BAD_SVC="badvpn-udpgw.service"
BAD_ENV="/etc/default/sshplus-badvpn"
DEFAULT_PORT="7300"
RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; CYAN='\033[1;36m'; NC='\033[0m'
ok(){ echo -e "${GREEN}$*${NC}"; }
warn(){ echo -e "${YELLOW}$*${NC}"; }
err(){ echo -e "${RED}$*${NC}"; }
pause(){ echo; read -r -p "Presioná ENTER para volver..." _; }
valid_port(){ [[ "$1" =~ ^[0-9]+$ ]] && (( "$1" >= 1 && "$1" <= 65535 )); }
port_current(){ [[ -f "$BAD_ENV" ]] && grep -E '^BADVPN_PORT=' "$BAD_ENV" | cut -d= -f2 | tr -d '[:space:]' | head -n1 || echo "$DEFAULT_PORT"; }
ensure_bin(){
  [[ -x "$BAD_BIN" ]] && return 0
  [[ -f "/etc/SSHPlus/badvpn-udpgw" ]] && cp -f /etc/SSHPlus/badvpn-udpgw "$BAD_BIN" && chmod 755 "$BAD_BIN" && return 0
  err "No encuentro $BAD_BIN. El instalador debe copiar badvpn-udpgw a /bin."
  return 1
}
write_service(){
  local port="${1:-$(port_current)}"; [[ -n "$port" ]] || port="$DEFAULT_PORT"
  mkdir -p /etc/default
  echo "BADVPN_PORT=$port" > "$BAD_ENV"
  chmod 644 "$BAD_ENV"
  cat > "/etc/systemd/system/$BAD_SVC" <<EOF
[Unit]
Description=BadVPN UDPGW para SSHPLUS BY El NeNe
After=network.target

[Service]
EnvironmentFile=-$BAD_ENV
ExecStart=$BAD_BIN --listen-addr 127.0.0.1:\${BADVPN_PORT:-$port} --max-clients 10000 --max-connections-for-client 8 --client-socket-sndbuf 10000 --udp-mtu 9000
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload >/dev/null 2>&1 || true
}
start_badvpn(){
  local port="${1:-$(port_current)}"; [[ -n "$port" ]] || port="$DEFAULT_PORT"
  valid_port "$port" || { err "Puerto inválido: $port"; return 1; }
  ensure_bin || return 1
  write_service "$port"
  systemctl enable "$BAD_SVC" >/dev/null 2>&1 || true
  systemctl restart "$BAD_SVC" >/dev/null 2>&1 || true
  sleep 1
  if systemctl is-active --quiet "$BAD_SVC"; then ok "BadVPN activo en 127.0.0.1:$port"; else warn "BadVPN no quedó activo. Revisá logs."; fi
}
stop_badvpn(){
  systemctl stop "$BAD_SVC" >/dev/null 2>&1 || true
  systemctl disable "$BAD_SVC" >/dev/null 2>&1 || true
  pkill -f 'badvpn-udpgw' >/dev/null 2>&1 || true
  ok "BadVPN detenido."
}
status_badvpn(){
  echo -e "${CYAN}Estado BadVPN:${NC}"
  if command -v systemctl >/dev/null 2>&1; then
    echo "Servicio: $(systemctl is-active "$BAD_SVC" 2>/dev/null || echo inactive) / $(systemctl is-enabled "$BAD_SVC" 2>/dev/null || echo disabled)"
  fi
  echo "Puerto ENV: $(port_current)"
  if command -v ss >/dev/null 2>&1; then ss -lunp 2>/dev/null | grep -E 'badvpn|7300|7296|7297|7298|7299|7200|7400|7500' || true
  elif command -v netstat >/dev/null 2>&1; then netstat -lunp 2>/dev/null | grep -E 'badvpn|7300|7296|7297|7298|7299|7200|7400|7500' || true
  fi
}
menu(){
  while true; do
    clear
    echo -e "${CYAN}╔════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║ BADVPN UDPGW - SSHPLUS El NeNe    ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════╝${NC}"
    status_badvpn
    echo
    echo "[1] Instalar/activar BadVPN puerto 7300"
    echo "[2] Activar BadVPN en otro puerto"
    echo "[3] Reiniciar BadVPN"
    echo "[4] Detener/deshabilitar BadVPN"
    echo "[5] Ver logs"
    echo "[0] Volver"
    echo
    read -r -p "Elegí opción: " op
    case "$op" in
      1) start_badvpn "$DEFAULT_PORT"; pause ;;
      2) read -r -p "Puerto: " p; start_badvpn "$p"; pause ;;
      3) start_badvpn "$(port_current)"; pause ;;
      4) stop_badvpn; pause ;;
      5) journalctl -u "$BAD_SVC" --no-pager -n 80 2>/dev/null || warn "No hay logs de systemd."; pause ;;
      0) clear; return 0 ;;
      *) warn "Opción inválida"; sleep 1 ;;
    esac
  done
}
menu
