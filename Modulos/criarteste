#!/bin/bash
# SSH-PLUS BY El NeNe Pro - Crear usuario de prueba
IP=$(cat /etc/IP 2>/dev/null || wget -qO- ipv4.icanhazip.com 2>/dev/null || hostname -I | awk '{print $1}')
DB="/root/usuarios.db"
PASSDIR="/etc/SSHPlus/senha"
TESTDIR="/etc/SSHPlus/userteste"
mkdir -p "$PASSDIR" "$TESTDIR" /etc/SSHPlus 2>/dev/null
touch "$DB" 2>/dev/null
valid_user() { [[ "$1" =~ ^[a-z_][a-z0-9_-]{1,24}$ ]]; }
valid_num() { [[ "$1" =~ ^[0-9]+$ ]] && [[ "$1" -ge 1 ]]; }

tput setaf 7; tput setab 4; tput bold; printf '%30s%s%-15s\n' "CREAR USUARIO TEST"; tput sgr0
echo ""
if [ "$(ls -A "$TESTDIR" 2>/dev/null)" ]; then
    echo -e "\033[1;32mTests activos:\033[0m"
    ls "$TESTDIR" | sed 's/.sh$//g' | sort
else
    echo -e "\033[1;31mNo hay tests activos.\033[0m"
fi

echo -ne "\n\033[1;32mUsuario:\033[1;37m "; read -r nome
if ! valid_user "$nome"; then echo -e "\n\033[41;1;37mUsuario vacío o inválido.\033[0m"; exit 1; fi
if getent passwd "$nome" >/dev/null; then echo -e "\n\033[41;1;37mEse usuario ya existe.\033[0m"; exit 1; fi

echo -ne "\033[1;32mContraseña:\033[1;37m "; read -r pass
if [[ ${#pass} -lt 4 ]]; then echo -e "\n\033[41;1;37mContraseña inválida. Mínimo 4 caracteres.\033[0m"; exit 1; fi

echo -ne "\033[1;32mLímite de conexiones:\033[1;37m "; read -r limit
if ! valid_num "$limit"; then echo -e "\n\033[41;1;37mLímite inválido.\033[0m"; exit 1; fi

echo -ne "\033[1;32mMinutos de duración \033[1;33m(Ej: 60)\033[1;37m: "; read -r u_temp
if ! valid_num "$u_temp"; then echo -e "\n\033[41;1;37mCantidad de minutos inválida.\033[0m"; exit 1; fi

if ! command -v at >/dev/null 2>&1; then
    echo -e "\n\033[41;1;37mNo está instalado 'at'. Instalalo para que los tests se borren solos.\033[0m"
    echo -e "\033[1;33mComando sugerido: apt install at -y && systemctl enable --now atd\033[0m"
    exit 1
fi

if ! useradd -M -s /bin/false "$nome" >/dev/null 2>&1; then
    echo -e "\n\033[41;1;37mNo se pudo crear el usuario test.\033[0m"; exit 1
fi
echo "$nome:$pass" | chpasswd >/dev/null 2>&1
printf '%s\n' "$pass" > "$PASSDIR/$nome"
grep -v -E "^${nome}[[:space:]]" "$DB" > /tmp/usuarios.db.$$ 2>/dev/null || true
mv /tmp/usuarios.db.$$ "$DB"
echo "$nome $limit" >> "$DB"

cat > "$TESTDIR/$nome.sh" <<EOF
#!/bin/bash
pkill -u "$nome" >/dev/null 2>&1
userdel -f "$nome" >/dev/null 2>&1
grep -v -E "^${nome}[[:space:]]" /root/usuarios.db > /tmp/usuarios.db.${nome} 2>/dev/null || true
mv /tmp/usuarios.db.${nome} /root/usuarios.db 2>/dev/null || true
rm -f "/etc/SSHPlus/senha/$nome" "$TESTDIR/$nome.sh"
exit 0
EOF
chmod +x "$TESTDIR/$nome.sh"
at -f "$TESTDIR/$nome.sh" now + "$u_temp" minutes >/dev/null 2>&1

clear
echo -e "\E[44;1;37m        USUARIO TEST CREADO        \E[0m"
echo -e "\033[1;32mIP:          \033[1;37m$IP"
echo -e "\033[1;32mUsuario:     \033[1;37m$nome"
echo -e "\033[1;32mContraseña:  \033[1;37m$pass"
echo -e "\033[1;32mLímite:      \033[1;37m$limit"
echo -e "\033[1;32mDuración:    \033[1;37m$u_temp minutos\033[0m"
echo -e "\n\033[1;33mAl cumplirse el tiempo, el usuario se desconecta y se elimina solo.\033[0m"
