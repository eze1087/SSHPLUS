#!/bin/bash
# SSH-PLUS BY El NeNe Pro - Crear usuario SSH
IP=$(cat /etc/IP 2>/dev/null || wget -qO- ipv4.icanhazip.com 2>/dev/null || hostname -I | awk '{print $1}')
cor1='\033[41;1;37m'
cor2='\033[44;1;37m'
scor='\033[0m'
DB="/root/usuarios.db"
PASSDIR="/etc/SSHPlus/senha"
VALOR_FILE="/root/valor"
mkdir -p "$PASSDIR" /etc/SSHPlus 2>/dev/null
touch "$DB" "$VALOR_FILE" 2>/dev/null

valid_user() { [[ "$1" =~ ^[a-z_][a-z0-9_-]{1,24}$ ]]; }
valid_num() { [[ "$1" =~ ^[0-9]+$ ]] && [[ "$1" -ge 1 ]]; }
pause_back() { echo -ne "\n\033[1;33mENTER \033[1;37mpara volver al \033[1;32mMENÚ\033[0m"; read -r _; }

# Generar client.ovpn
newclient() {
    local user="$1"
    cp /etc/openvpn/client-common.txt "/root/${user}.ovpn"
    echo "<ca>" >>"/root/${user}.ovpn"
    cat /etc/openvpn/easy-rsa/pki/ca.crt >>"/root/${user}.ovpn"
    echo "</ca>" >>"/root/${user}.ovpn"
    echo "<cert>" >>"/root/${user}.ovpn"
    cat "/etc/openvpn/easy-rsa/pki/issued/${user}.crt" >>"/root/${user}.ovpn"
    echo "</cert>" >>"/root/${user}.ovpn"
    echo "<key>" >>"/root/${user}.ovpn"
    cat "/etc/openvpn/easy-rsa/pki/private/${user}.key" >>"/root/${user}.ovpn"
    echo "</key>" >>"/root/${user}.ovpn"
    echo "<tls-auth>" >>"/root/${user}.ovpn"
    cat /etc/openvpn/ta.key >>"/root/${user}.ovpn"
    echo "</tls-auth>" >>"/root/${user}.ovpn"
}

fun_geraovpn() {
    [[ ! -d /etc/openvpn/easy-rsa ]] && return 1
    cd /etc/openvpn/easy-rsa/ || return 1
    ./easyrsa build-client-full "$username" nopass >/dev/null 2>&1 || return 1
    newclient "$username" >/dev/null 2>&1 || return 1
    if [[ "$respost" =~ ^[sS]$ ]]; then
        sed -e "s;auth-user-pass;<auth-user-pass>\n$username\n$password\n</auth-user-pass>;g" "/root/${username}.ovpn" > /root/tmp.ovpn && mv -f /root/tmp.ovpn "/root/${username}.ovpn"
    fi
}

if [[ -e /etc/openvpn/server.conf ]]; then
    _Port=$(awk '/^port /{print $2; exit}' /etc/openvpn/server.conf)
    hst=$(sed -n '8 p' /etc/openvpn/client-common.txt 2>/dev/null | awk '{print $4}')
    hedr=$(sed -n '8 p' /etc/openvpn/client-common.txt 2>/dev/null)
    rmt2='/SSHPLUS?'
    rmt3='www.vivo.com.br 8088'
    prx='200.142.130.104'
    payload1='#payload "HTTP/1.0 [crlf]Host: m.youtube.com[crlf]CONNECT HTTP/1.0[crlf][crlf]|[crlf]"'
    payload2='#payload "CONNECT 127.0.0.1:1194[split][crlf] HTTP/1.0 [crlf][crlf]#"'
    vivo1="portalrecarga.vivo.com.br/recarga"
    vivo3="navegue.vivo.com.br/pre/"
    oi="d1n212ccp6ldpw.cloudfront.net"
    bypass="net_gateway"
    cert01="/etc/openvpn/client-common.txt"
    if [[ "$hst" == "$vivo1" ]]; then Host="Portal Recarga"
    elif [[ "$hst" == "$vivo3" ]]; then Host="Portal Navegue"
    elif [[ "$hst" == "$IP:$_Port" ]]; then Host="Vivo MMS"
    elif [[ "$hst" == "$oi" ]]; then Host="Oi"
    elif [[ "$hst" == "$bypass" ]]; then Host="Modo Bypass"
    elif [[ "$hedr" == "$payload1" ]]; then Host="OPEN SOCKS"
    elif [[ "$hedr" == "$payload2" ]]; then Host="OPEN SQUID"
    else Host="Personalizado"; fi
fi

fun_bar() {
    local cmd1="$1" cmd2="$2"
    (
        [[ -e $HOME/fim ]] && rm -f "$HOME/fim"
        eval "$cmd1" >/dev/null 2>&1
        [[ -n "$cmd2" ]] && eval "$cmd2" >/dev/null 2>&1
        touch "$HOME/fim"
    ) >/dev/null 2>&1 &
    tput civis 2>/dev/null || true
    echo -ne "\033[1;33mAGUARDÁ \033[1;37m- \033[1;33m["
    while true; do
        for ((i=0; i<18; i++)); do echo -ne "\033[1;31m#"; sleep 0.1s; done
        [[ -e $HOME/fim ]] && rm -f "$HOME/fim" && break
        echo -e "\033[1;33m]"; sleep 1s; tput cuu1 2>/dev/null || true; tput dl1 2>/dev/null || true
        echo -ne "\033[1;33mAGUARDÁ \033[1;37m- \033[1;33m["
    done
    echo -e "\033[1;33m]\033[1;37m -\033[1;32m OK!\033[1;37m"
    tput cnorm 2>/dev/null || true
}

fun_edithost() {
    [[ ! -e /etc/openvpn/client-common.txt ]] && return 1
    clear
    echo -e "\E[44;1;37m          CAMBIAR HOST OVPN             \E[0m"
    echo -e "\033[1;33mHOST EN USO\033[1;37m: \033[1;32m${Host:-Personalizado}\033[0m\n"
    echo -e "\033[1;31m[\033[1;36m1\033[1;31m] \033[1;33mVIVO RECARGA"
    echo -e "\033[1;31m[\033[1;36m2\033[1;31m] \033[1;33mVIVO NAVEGUE PRE"
    echo -e "\033[1;31m[\033[1;36m3\033[1;31m] \033[1;33mOPEN SOCKS"
    echo -e "\033[1;31m[\033[1;36m4\033[1;31m] \033[1;33mOPEN SQUID"
    echo -e "\033[1;31m[\033[1;36m5\033[1;31m] \033[1;33mVIVO MMS"
    echo -e "\033[1;31m[\033[1;36m6\033[1;31m] \033[1;33mMODO BYPASS"
    echo -e "\033[1;31m[\033[1;36m7\033[1;31m] \033[1;33mTODOS LOS HOSTS"
    echo -e "\033[1;31m[\033[1;36m8\033[1;31m] \033[1;33mEDITAR MANUALMENTE"
    echo -e "\033[1;31m[\033[1;36m0\033[1;31m] \033[1;33mVOLVER\033[0m\n"
    echo -ne "\033[1;32m¿Qué host querés usar? \033[1;37m"; read -r respo
    case "$respo" in
        1) fun_bar "sed -i '7,9d' '$cert01'; sed -i '7i\\remote $rmt2 $_Port\nhttp-proxy-option CUSTOM-HEADER Host $vivo1\nhttp-proxy $IP 80' '$cert01'"; fun_geraovpn ;;
        2) fun_bar "sed -i '7,9d' '$cert01'; sed -i '7i\\remote $rmt2 $_Port\nhttp-proxy-option CUSTOM-HEADER Host $vivo3\nhttp-proxy $IP 80' '$cert01'"; fun_geraovpn ;;
        3) fun_bar "sed -i '7,9d' '$cert01'; sed -i '7i\\remote $rmt2 $_Port\n$payload1\nhttp-proxy $IP 8080' '$cert01'"; fun_geraovpn ;;
        4) fun_bar "sed -i '7,9d' '$cert01'; sed -i '7i\\remote $rmt2 $_Port\n$payload2\nhttp-proxy $IP 80' '$cert01'"; fun_geraovpn ;;
        5) fun_bar "sed -i '7,9d' '$cert01'; sed -i '7i\\remote $rmt3\nhttp-proxy-option CUSTOM-HEADER Host $vivo3\nhttp-proxy $prx:$_Port' '$cert01'"; fun_geraovpn ;;
        6) fun_bar "sed -i '7,9d' '$cert01'; sed -i '7i\\remote $IP $_Port\nroute $IP 255.255.255.255 net_gateway\nhttp-proxy 127.0.0.1 8989' '$cert01'"; fun_geraovpn ;;
        7)
            [[ ! -e "/root/$username.ovpn" ]] && fun_geraovpn
            mkdir -p /root/OVPN
            cp "/root/$username.ovpn" "/root/OVPN/${username}-base.ovpn" 2>/dev/null
            (cd /root/OVPN && zip -q "/root/${username}.zip" *.ovpn)
            rm -rf /root/OVPN
            ;;
        8) nano /etc/openvpn/client-common.txt; fun_geraovpn ;;
        0) return 0 ;;
        *) echo -e "\n\033[1;31mOpción inválida.\033[0m"; sleep 2 ;;
    esac
}

clear
tput setaf 7; tput setab 4; tput bold; printf '%30s%s%-15s\n' "CREAR USUARIO SSH"; tput sgr0
echo -ne "\033[1;32mUSUARIO:\033[1;37m "; read -r username
if ! valid_user "$username"; then
    echo -e "\n${cor1}Usuario inválido. Usá 2 a 25 caracteres: minúsculas, números, _ o -. Debe empezar con letra o _.${scor}\n"; exit 1
fi
if getent passwd "$username" >/dev/null; then
    echo -e "\n${cor1}Ese usuario ya existe. Probá con otro nombre.${scor}\n"; exit 1
fi

echo -ne "\033[1;32mCONTRASEÑA:\033[1;37m "; read -r password
if [[ ${#password} -lt 4 ]]; then echo -e "\n${cor1}Contraseña inválida. Mínimo 4 caracteres.${scor}\n"; exit 1; fi

echo -ne "\033[1;32mDÍAS DE VIGENCIA:\033[1;37m "; read -r dias
if ! valid_num "$dias"; then echo -e "\n${cor1}Cantidad de días inválida.${scor}\n"; exit 1; fi

echo -ne "\033[1;32mLÍMITE DE CONEXIONES:\033[1;37m "; read -r sshlimiter
if ! valid_num "$sshlimiter"; then echo -e "\n${cor1}Límite de conexiones inválido.${scor}\n"; exit 1; fi

echo -ne "\033[1;32mVALOR/NOTA DEL CLIENTE:\033[1;37m "; read -r vl
[[ -z "$vl" ]] && vl="0"

final=$(date "+%Y-%m-%d" -d "+$dias days")
gui=$(date "+%d/%m/%Y" -d "+$dias days")

if ! useradd -e "$final" -M -s /bin/false "$username" >/dev/null 2>&1; then
    echo -e "\n${cor1}No se pudo crear el usuario. Revisá permisos o el nombre ingresado.${scor}\n"; exit 1
fi
echo "$username:$password" | chpasswd >/dev/null 2>&1
printf '%s\n' "$password" > "$PASSDIR/$username"
grep -v -E "^${username}[[:space:]]" "$DB" > /tmp/usuarios.db.$$ 2>/dev/null || true
mv /tmp/usuarios.db.$$ "$DB"
echo "$username $sshlimiter" >> "$DB"
printf '%s\n' "$vl" >> "$VALOR_FILE"

if [[ -e /etc/openvpn/server.conf ]]; then
    echo -ne "\033[1;32m¿Generar archivo OVPN? \033[1;33m[s/n]: \033[1;37m"; read -r resp
    if [[ "$resp" =~ ^[sS]$ ]]; then
        rm -f "/root/${username}.zip" "/root/${username}.ovpn" >/dev/null 2>&1
        echo -ne "\033[1;32m¿Guardar usuario y contraseña dentro del OVPN? \033[1;33m[s/n]: \033[1;37m"; read -r respost
        echo -ne "\033[1;32mHost actual\033[1;37m: \033[1;31m(\033[1;37m${Host:-Personalizado}\033[1;31m) \033[1;32m¿Cambiar? \033[1;33m[s/n]: \033[1;37m"; read -r oprc
        if [[ "$oprc" =~ ^[sS]$ ]]; then fun_edithost; else fun_geraovpn; fi
        [[ -e "/root/${username}.ovpn" ]] && zip -q "/root/${username}.zip" "/root/${username}.ovpn"
        [[ -d /var/www/html/openvpn && -e "/root/${username}.zip" ]] && mv "/root/${username}.zip" "/var/www/html/openvpn/${username}.zip" >/dev/null 2>&1
    fi
fi

clear
echo -e "\E[44;1;37m======== DATOS DE ACCESO ========\E[0m"
echo -e "\033[1;32mUsuario:      \033[1;37m$username"
echo -e "\033[1;32mContraseña:   \033[1;37m$password"
echo -e "\033[1;32mExpira:       \033[1;37m$gui"
echo -e "\033[1;32mConexiones:   \033[1;37m$sshlimiter"
echo -e "\033[1;32mValor/nota:   \033[1;37m$vl"
if [[ -e "/var/www/html/openvpn/${username}.zip" ]]; then
    echo -e "\033[1;32mOVPN:         \033[1;36mhttp://$IP:81/openvpn/${username}.zip\033[0m"
elif [[ -e "/root/${username}.zip" ]]; then
    echo -e "\033[1;32mOVPN:         \033[1;37m/root/${username}.zip\033[0m"
fi
pause_back
