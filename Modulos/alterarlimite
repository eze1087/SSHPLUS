#!/bin/bash
# SSH-PLUS BY El NeNe Pro - Cambiar límite de conexiones
DB="/root/usuarios.db"
touch "$DB" 2>/dev/null
valid_num() { [[ "$1" =~ ^[0-9]+$ ]] && [[ "$1" -ge 1 ]]; }
list_users() { awk -F: '$3>=1000 && $1!="nobody" {print $1}' /etc/passwd | sort; }
get_limit() { awk -v u="$1" '$1==u {print $2; found=1} END{if(!found) print 1}' "$DB"; }

tput setaf 7; tput setab 4; tput bold; printf '%20s%s\n' "   CAMBIAR LÍMITE DE CONEXIONES   "; tput sgr0
echo -e "\n\033[1;33mLISTA DE USUARIOS Y LÍMITES:\033[0m\n"
i=0; unset MAP_USER
while read -r user; do
    [[ -z "$user" ]] && continue
    i=$((i+1)); MAP_USER[$i]="$user"
    printf '\033[1;31m[\033[1;36m%02d\033[1;31m] \033[1;37m- \033[1;32m%-18s\033[1;33m Límite: \033[1;37m%s\033[0m\n' "$i" "$user" "$(get_limit "$user")"
done <<< "$(list_users)"
[[ $i -eq 0 ]] && { echo -e "\033[1;31mNo hay usuarios.\033[0m"; exit 1; }

echo -ne "\n\033[1;32mEscribí número o nombre de usuario:\033[1;37m "; read -r option
if [[ "$option" =~ ^[0-9]+$ ]]; then usuario="${MAP_USER[$((10#$option))]}"; else usuario="$option"; fi
[[ -z "$usuario" ]] || ! getent passwd "$usuario" >/dev/null && { echo -e "\033[1;31mUsuario inválido.\033[0m"; exit 1; }

echo -ne "\n\033[1;32mNuevo límite para \033[1;33m$usuario\033[1;37m: "; read -r sshnum
if ! valid_num "$sshnum"; then echo -e "\033[1;31mNúmero inválido. Debe ser mayor que cero.\033[0m"; exit 1; fi

grep -v -E "^${usuario}[[:space:]]" "$DB" > /tmp/usuarios.db.$$ 2>/dev/null || true
mv /tmp/usuarios.db.$$ "$DB"
echo "$usuario $sshnum" >> "$DB"
echo -e "\n\E[44;1;37m Límite aplicado: $usuario = $sshnum conexiones \E[0m"
